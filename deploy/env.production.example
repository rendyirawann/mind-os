# =============================================================================
# Mind OS — production .env for https://mindos.mooda.id
#
# Copy to /var/www/mindos.mooda.id/.env on the server, then replace every
# value marked GANTI_*. Never commit the filled-in copy.
#
# Isolation from other projects on the same server:
#   - own database + own PostgreSQL role (DB_DATABASE / DB_USERNAME)
#   - host-only session cookie with its own name (SESSION_DOMAIN empty)
#   - own cache prefix; cache, sessions and queue live in this app's own DB
#   - no Redis, no Reverb port needed (BROADCAST_CONNECTION=log)
# =============================================================================

APP_NAME="Mind OS"
APP_TITLE="Mind OS — Hipnoterapi & Kesehatan Mental Metode 6R"
APP_TAGLINE="Hipnoterapi untuk Pikiran yang Sehat & Tenang"
APP_ENV=production
# Generated on the server with `php artisan key:generate --force` — ONCE.
# Regenerating it later logs everyone out and breaks encrypted sessions.
APP_KEY=
APP_DEBUG=false
APP_URL=https://mindos.mooda.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files under storage/logs, kept 14 days.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (dedicated to Mind OS) ----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Check with: sudo -u postgres psql -c "SHOW port;"
DB_PORT=5432
DB_DATABASE=mindos
DB_USERNAME=mindos
DB_PASSWORD=GANTI_PASSWORD_DATABASE

# --- Session (host-only cookie: never shared with *.mooda.id apps) ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=mindos_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# --- Cache / queue / broadcast ----------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=mindos_cache_
QUEUE_CONNECTION=database
# No realtime server needed; "log" keeps broadcasts from failing.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# --- Mail (password reset etc.) ---------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=GANTI_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=GANTI_SMTP_USER
MAIL_PASSWORD=GANTI_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@mindos.mooda.id
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Security ---------------------------------------------------------------
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_UPGRADE_INSECURE=true
SECURITY_CSP_EXTRA_HOSTS=
# Applies to mindos.mooda.id and its own sub-domains only, never to mooda.id.
SECURITY_HSTS=true
SECURITY_BLOCK_SUSPICIOUS=true

RATE_LIMIT_WEB=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_WRITE=60
RATE_LIMIT_API=60

CORS_ALLOWED_ORIGINS=https://mindos.mooda.id
CORS_ALLOWED_ORIGIN_PATTERNS=

# Leave empty when nginx talks to PHP-FPM directly. If the domain is proxied
# through Cloudflare / a load balancer, put that proxy's IP ranges here.
TRUSTED_PROXIES=

# --- First-time seeding -----------------------------------------------------
# Initial password for accounts created by AccountSeeder. Existing accounts
# are never overwritten. Change each password after the first login.
SEED_DEFAULT_PASSWORD="GANTI_PASSWORD_AWAL_AKUN"
